{
    "name": "local-shader-viewer",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,html,md}\"",
        "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,html,md}\"",
        "check": "npm run lint && npm run format:check && npm test && npm run build"
    },
    "dependencies": {
        "react": "latest",
        "react-dom": "latest"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@testing-library/jest-dom": "latest",
        "@testing-library/react": "latest",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "latest",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "jsdom": "latest",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "latest",
        "vitest": "latest"
    }
}
