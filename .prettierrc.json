{
    "printWidth": 80,
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all",
    "proseWrap": "always",
    "tabWidth": 4,
    "plugins": ["prettier-plugin-glsl"],
    "overrides": [
        {
            "files": "*.frag",
            "options": {
                "parser": "glsl-parser"
            }
        }
    ]
}
